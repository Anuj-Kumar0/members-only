<div class="error-container">

    <h1 class="error-code">
        <%= status %>
    </h1>

    <p class="error-message">
        <%= message %>
    </p>

    <p class="error-description">
        Something went wrong. Try going back to the homepage.
    </p>

    <a href="/" class="error-home">Home</a>

</div>